# ======================= ENGLISH =======================
# Fake/real classifier (pretrained, downloaded on first run). Labels per its model card: LABEL_0 = fake, LABEL_1 = real.
MODEL_EN_PATH=jy46604790/Fake-News-Bert-Detect
MODEL_EN_FAKE_LABEL=LABEL_0
# Claim-vs-evidence judge for English: a large NLI model trained on FEVER (fact verification) + MNLI + ANLI. MIT licence.
# Empty = use the multilingual model below for English too (smaller/faster, less accurate).
NLI_MODEL_EN=MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli

# ======================= HINDI + MARATHI =======================
# Native classifier = DevBERT (l3cube-pune/hindi-marathi-dev-bert) that YOU fine-tune once with ml/training (see README).
# Put the result in models/dev. Until that folder exists, Hindi/Marathi automatically fall back to translate-then-classify.
MODEL_HI_PATH=../models/dev
MODEL_MR_PATH=../models/dev
MODEL_HI_FAKE_LABEL=
MODEL_MR_FAKE_LABEL=
# Claim-vs-evidence judge for Hindi/Marathi (multilingual NLI, MIT). Empty = no stance detection for them.
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
# Fallback only: machine translation so the English classifier can read Hindi/Marathi. CC-BY-NC research model; empty = off.
TRANSLATE_MODEL=facebook/nllb-200-distilled-600M
TRANSLATE_MAX_CHARS=1200
HF_TOKEN=

# ======================= SHARED MODEL SETTINGS =======================
MAX_TOKENS=256
# Classifiers learned from full articles: below this many words the model estimate is shown as Uncertain.
MIN_CLASSIFIER_WORDS=40
# Commit to Fake/Real only at >= this probability (neural classifiers are over-confident; keep it high).
CLASSIFIER_THRESHOLD=0.85
PRELOAD_MODELS=true
# Multilingual embeddings for semantic relevance in retrieval (empty = word overlap only).
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ======================= EVIDENCE PROVIDERS (keys stay on the server) =======================
GOOGLE_FACTCHECK_API_KEY=
NEWSAPI_KEY=
ENABLE_GDELT=true
ENABLE_GOOGLE_NEWS_RSS=true

# ======================= OPTIONAL LLM SUMMARY (verdict never comes from the LLM) =======================
ENABLE_LLM_SUMMARY=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# ======================= STORAGE / LIMITS =======================
DB_PATH=data/fnd.sqlite3
STORE_TEXT=false
ENABLE_HISTORY=true
MAX_INPUT_CHARS=5000
RATE_LIMIT_PER_MIN=20
REQUEST_TIMEOUT_SEC=8
ANALYZE_TIMEOUT_SEC=90
CACHE_TTL_SEC=900
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
